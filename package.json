{
  "name": "scholia-alexa",
  "version": "0.1.0",
  "description": "Scholia for Alexa+: course-grounded voice tutor that remembers the learner. MCP server over Streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "sim": "tsx watch src/sim/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:sim": "node dist/sim/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-polly": "^3.1147.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
